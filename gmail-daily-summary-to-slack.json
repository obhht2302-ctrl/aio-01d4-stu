      "id": "dfb2f6d3-84a0-4fea-85fd-a26e1a7151c3",
      "name": "Gmail 본문 가져오기",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [
        660,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "const emails = $input.all().map(({ json }) => {\n  const headers = json.payload?.headers ?? [];\n  const header = (name) => headers.find((h) => h.name?.toLowerCase() === name.toLowerCase())?.value ?? '';\n  const decode = (value = '') => Buffer.from(value.replace(/-/g, '+').replace(/_/g, '/'), 'base64').toString('utf8');\n  const findText = (part) => {\n    if (!part) return '';\n    if (part.mimeType === 'text/plain' && part.body?.data) return decode(part.body.data);\n    return (part.parts ?? []).map(findText).find(Boolean) ?? '';\n  };\n  return {\n    from: header('From'),\n    subject: header('Subject') || '(제목 없음)',\n    date: header('Date'),\n    body: findText(json.payload).slice(0, 12000),\n  };\n});\n\nreturn [{ json: { emails, sourceText: emails.map((email, index) => `메일 ${index + 1}\\n보낸 사람: ${email.from}\\n제목: ${email.subject}\\n날짜: ${email.date}\\n본문:\\n${email.body}`).join('\\n\\n---\\n\\n') } }];"
      },
      "id": "3f6f5e68-4cd2-4bc0-8073-46596f9b6721",
      "name": "메일 묶기",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        880,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.openai.com/v1/chat/completions",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "openAiApi",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ model: $('검색 조건 설정').first().json.model, temperature: 0.2, messages: [ { role: 'system', content: '당신은 업무 메일 요약 도우미입니다. 입력된 메일 전체를 한국어로 요약하세요. Slack에 게시할 Markdown 형식으로 작성합니다. 맨 위에 메일 수를 표시하고, 메일별로 보낸 사람·제목·핵심 요지·필요한 조치(없으면 없음)를 짧게 적으세요. 추측하지 말고, 민감한 개인정보는 반복하지 마세요.' }, { role: 'user', content: $('메일 묶기').first().json.sourceText } ] }) }}",
        "options": {
          "timeout": 180000
        }
      },
      "id": "59079043-b6b5-49fb-b3b0-11d7037d6959",
      "name": "OpenAI로 요약",
